{
  "version": 8,
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "__PMTILES_URL__",
      "attribution": "© OpenStreetMap contributors · © OpenMapTiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f1e8"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#e2e8df",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#ecefe6",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "basemap",
      "source-layer": "park",
      "paint": {
        "fill-color": "#d5e5d1",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#cfe3e8"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "basemap",
      "source-layer": "waterway",
      "minzoom": 5,
      "paint": {
        "line-color": "#79b7c8",
        "line-opacity": 0.9,
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 0.8,
          9, 1.4,
          14, 3.2
        ]
      }
    },
    {
      "id": "transportation-casing",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 5,
      "paint": {
        "line-color": "#fffdf7",
        "line-opacity": 0.95,
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 1.8,
          8, 2.8,
          12, 5.5,
          16, 10
        ]
      }
    },
    {
      "id": "transportation",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 5,
      "paint": {
        "line-color": "#b59f83",
        "line-opacity": 0.95,
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 0.9,
          8, 1.5,
          12, 3.2,
          16, 6
        ]
      }
    },
    {
      "id": "transportation-trails",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "in",
        ["get", "class"],
        "path",
        "track",
        "footway",
        "pedestrian",
        "cycleway",
        "steps"
      ],
      "paint": {
        "line-color": "#8c9a78",
        "line-opacity": 0.95,
        "line-dasharray": [2, 1.5],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11, 1,
          15, 2.8
        ]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#92958f",
        "line-opacity": 0.7,
        "line-width": 0.8,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "aeroway",
      "type": "line",
      "source": "basemap",
      "source-layer": "aeroway",
      "paint": {
        "line-color": "#bdb7ad",
        "line-width": 1.1
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "basemap",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d8d2c8",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "place-points",
      "type": "circle",
      "source": "basemap",
      "source-layer": "place",
      "minzoom": 5,
      "paint": {
        "circle-color": "#34443d",
        "circle-opacity": 0.9,
        "circle-stroke-color": "#f4f1e8",
        "circle-stroke-width": 1,
        "circle-radius": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 2.5,
          9, 3.5,
          13, 5
        ]
      }
    }
  ]
}
