{
  "version": 8,
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "__PMTILES_URL__",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f1e8"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#e2e8df",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#ecefe6",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "basemap",
      "source-layer": "park",
      "paint": {
        "fill-color": "#d5e5d1",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#cfe3e8"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "basemap",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#9fc8d3",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 0.8,
          14, 2.4
        ]
      }
    },
    {
      "id": "transportation",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 7,
      "paint": {
        "line-color": "#b9ad99",
        "line-opacity": 0.95,
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7, 0.45,
          10, 1.0,
          12, 1.8,
          14, 3.2
        ]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#92958f",
        "line-opacity": 0.7,
        "line-width": 0.8,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "aeroway",
      "type": "line",
      "source": "basemap",
      "source-layer": "aeroway",
      "paint": {
        "line-color": "#bdb7ad",
        "line-width": 1.1
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "basemap",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d8d2c8",
        "fill-opacity": 0.75
      }
    }
  ]
}
