{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://espanaoutdoor.es/schemas/source-gateway.json",
  "title": "España Outdoor Source Gateway contracts",
  "$defs": {
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "observedAt",
        "licenseUrl",
        "attribution"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["official", "community", "derived"]
        },
        "status": {
          "type": "string",
          "enum": ["healthy", "degraded", "unavailable", "stale"]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "licenseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "provenance", "freshness"],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "licenseUrl", "observedAt"],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "licenseUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "fetchedAt"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["current", "aging", "stale"]
            },
            "fetchedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
