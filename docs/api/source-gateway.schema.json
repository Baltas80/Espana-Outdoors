{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://espanaoutdoor.es/schemas/source-gateway.json",
  "title": "España Outdoor Source Gateway contracts",
  "$defs": {
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "observedAt", "licenseUrl", "attribution"],
      "properties": {
        "kind": { "type": "string", "enum": ["official", "community", "derived"] },
        "status": { "type": "string", "enum": ["healthy", "degraded", "unavailable", "stale"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "licenseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "attribution": { "type": "string", "minLength": 1 }
      }
    },
    "dataEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "provenance", "freshness"],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "condition",
              "min",
              "max",
              "precipitationProbability",
              "precipitationMm",
              "windSpeed",
              "windDirection"
            ],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "condition": {
                "type": "string",
                "enum": ["clear", "partlyCloudy", "cloudy", "rain", "storm", "snow", "fog", "unknown"]
              },
              "min": { "type": ["number", "null"] },
              "max": { "type": ["number", "null"] },
              "precipitationProbability": { "type": ["number", "null"] },
              "precipitationMm": { "type": ["number", "null"] },
              "windSpeed": { "type": ["number", "null"] },
              "windDirection": { "type": ["string", "null"] }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "licenseUrl", "observedAt"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "licenseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
            "observedAt": { "type": "string", "format": "date-time" }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "fetchedAt"],
          "properties": {
            "status": { "type": "string", "enum": ["current", "aging", "stale"] },
            "fetchedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}
