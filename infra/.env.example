# Never commit real credentials. Copy to .env locally.
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

OIDC_ISSUER=http://keycloak:8080/realms/espana-outdoor
OIDC_AUDIENCE=espana-outdoors-mobile
PUBLIC_SHARE_BASE_URL=https://rescue.example.com
LOCATION_ENCRYPTION_KEY=SET_IN_SECRET_MANAGER

# AEMET credentials must be stored in the deployment secret manager, never in Git.
AEMET_API_KEY=change-me
# Replace locally with the actual RFC3339 expiry issued for this credential.
AEMET_API_KEY_EXPIRES_AT=change-me

VALHALLA_TILE_URLS=
MAP_PMTILES_URL=
